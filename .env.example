# ============================================
# База данных (сервис postgres в docker-compose)
# ============================================
DB_HOST=postgres
DB_NAME=archive_fqp
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT=5432

# ============================================
# Порты сервисов
# ============================================
BLAZOR_PORT=8001
AI_PORT=8002

# ============================================
# Ollama (запущена на хосте, не в контейнере)
# ============================================
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=llama3.2
EMBED_MODEL=all-minilm

# ============================================
# ASP.NET
# ============================================
ASPNETCORE_ENVIRONMENT=Production

# ============================================
# HTTPS-сертификат контейнера (certs/aspnetapp.pfx)
# Пароль задаётся при экспорте dev-сертификата:
#   dotnet dev-certs https -ep certs/aspnetapp.pfx -p <этот_пароль>
# ============================================
DEV_CERT_PASSWORD=change_me

# ============================================
# 3KL (OAuth-провайдер образовательного портала)
# Значения выдаёт администратор портала
# ============================================
THREEKL_CLIENT_ID=your_client_id
THREEKL_CLIENT_SECRET=your_client_secret
THREEKL_AUTH_ENDPOINT=https://your-3kl-host/local/oauth/login.php
THREEKL_TOKEN_ENDPOINT=https://your-3kl-host/local/oauth/token.php
THREEKL_USERINFO_ENDPOINT=https://your-3kl-host/local/oauth/user_info.php
THREEKL_REDIRECT_URI=https://your-domain/signin-3kl

# ============================================
# Почта (SMTP) для уведомлений
# ============================================
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_SENDER_NAME=Реестр ВКР
SMTP_SENDER_EMAIL=from@example.com
SMTP_USERNAME=your_login
SMTP_PASSWORD=your_app_password
